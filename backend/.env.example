# Copie este arquivo para .env e ajuste os valores (o .env nunca vai para o GitHub)

# Porta da API
PORT=3333

# String de conexão do PostgreSQL (local ou Neon).
# Neon: use a string do painel, que termina com ?sslmode=require
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sisgom

# Chave usada para assinar os tokens de login. Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRA=8h

# Endereços do front-end liberados no CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173
